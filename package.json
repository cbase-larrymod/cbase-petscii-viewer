{
    "name": "cbase-petscii-viewer",
    "displayName": "C*Base PETSCII Viewer",
    "description": "C64 PETSCII .seq and .petmate file viewer for C*Base BBS files",
    "version": "0.6.0-beta",
    "publisher": "cbase-larrymod",
    "icon": "media/icon.png",
    "license": "GPL-2.0-or-later",
    "repository": {
        "type": "git",
        "url": "https://github.com/cbase-larrymod/cbase-petscii-viewer.git"
    },
    "bugs": {
        "url": "https://github.com/cbase-larrymod/cbase-petscii-viewer/issues"
    },
    "homepage": "https://github.com/cbase-larrymod/cbase-petscii-viewer#readme",
    "keywords": [
        "petscii",
        "c64",
        "commodore 64",
        "bbs",
        "seq",
        "c*base"
    ],
    "engines": {
        "vscode": "^1.105.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCustomEditor:cbase.seqViewer",
        "onCustomEditor:cbase.petmateViewer"
    ],
    "main": "./out/extension",
    "contributes": {
        "customEditors": [
            {
                "viewType": "cbase.seqViewer",
                "displayName": "PETSCII Viewer",
                "selector": [
                    {
                        "filenamePattern": "*.seq"
                    }
                ],
                "priority": "default"
            },
            {
                "viewType": "cbase.petmateViewer",
                "displayName": "PETSCII Viewer (Petmate)",
                "selector": [
                    {
                        "filenamePattern": "*.petmate"
                    }
                ],
                "priority": "default"
            }
        ],
        "commands": [
            {
                "command": "cbase.openSeqFile",
                "title": "C*Base: Open .seq File..."
            },
            {
                "command": "cbase.openPetmateFile",
                "title": "C*Base: Open .petmate File..."
            },
            {
                "command": "cbase-petscii-viewer.view.mci",
                "title": "Toggle MCI Commands",
                "category": "C*Base"
            },
            {
                "command": "cbase-petscii-viewer.view.cls",
                "title": "Toggle Show CLS ($93)",
                "category": "C*Base"
            },
            {
                "command": "cbase-petscii-viewer.palette.1",
                "title": "Use Colour Palette 1",
                "category": "C*Base"
            },
            {
                "command": "cbase-petscii-viewer.palette.2",
                "title": "Use Colour Palette 2",
                "category": "C*Base"
            },
            {
                "command": "cbase-petscii-viewer.palette.3",
                "title": "Use Colour Palette 3",
                "category": "C*Base"
            },
            {
                "command": "cbase-petscii-viewer.palette.4",
                "title": "Use Colour Palette 4",
                "category": "C*Base"
            },
            {
                "command": "cbase-petscii-viewer.palette.5",
                "title": "Use Colour Palette 5",
                "category": "C*Base"
            },
            {
                "command": "cbase-petscii-viewer.palette.6",
                "title": "Use Colour Palette 6",
                "category": "C*Base"
            }
        ],
        "keybindings": [
            {
                "command": "cbase-petscii-viewer.view.mci",
                "key": "alt+shift+m",
                "when": "cbasePetsciiFocused"
            },
            {
                "command": "cbase-petscii-viewer.view.cls",
                "key": "alt+shift+l",
                "when": "cbasePetsciiFocused"
            },
            {
                "command": "cbase-petscii-viewer.palette.1",
                "key": "alt+1",
                "when": "cbasePetsciiFocused"
            },
            {
                "command": "cbase-petscii-viewer.palette.2",
                "key": "alt+2",
                "when": "cbasePetsciiFocused"
            },
            {
                "command": "cbase-petscii-viewer.palette.3",
                "key": "alt+3",
                "when": "cbasePetsciiFocused"
            },
            {
                "command": "cbase-petscii-viewer.palette.4",
                "key": "alt+4",
                "when": "cbasePetsciiFocused"
            },
            {
                "command": "cbase-petscii-viewer.palette.5",
                "key": "alt+5",
                "when": "cbasePetsciiFocused"
            },
            {
                "command": "cbase-petscii-viewer.palette.6",
                "key": "alt+6",
                "when": "cbasePetsciiFocused"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "cbase-petscii-viewer.view.mci",
                    "when": "false"
                },
                {
                    "command": "cbase-petscii-viewer.view.cls",
                    "when": "false"
                },
                {
                    "command": "cbase-petscii-viewer.palette.1",
                    "when": "false"
                },
                {
                    "command": "cbase-petscii-viewer.palette.2",
                    "when": "false"
                },
                {
                    "command": "cbase-petscii-viewer.palette.3",
                    "when": "false"
                },
                {
                    "command": "cbase-petscii-viewer.palette.4",
                    "when": "false"
                },
                {
                    "command": "cbase-petscii-viewer.palette.5",
                    "when": "false"
                },
                {
                    "command": "cbase-petscii-viewer.palette.6",
                    "when": "false"
                }
            ]
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "npm run compile && npm test && node -e \"const fs=require('fs'); if(!fs.existsSync('dist'))fs.mkdirSync('dist')\" && vsce package -o dist/",
        "test": "node test/viewKeys.test.js"
    },
    "devDependencies": {
        "@types/vscode": "^1.80.0",
        "@vscode/vsce": "^3.9.2",
        "typescript": "^5.0.0"
    }
}
